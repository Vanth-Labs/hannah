{
  "name": "hannah-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "sidecar:asr": "cd sidecar/asr && ../.venv/bin/python -m uvicorn main:app --port 8001 --reload",
    "sidecar:tts": "cd sidecar/tts && ../.venv/bin/python -m uvicorn main:app --port 8002 --reload",
    "sidecar:vision": "cd sidecar/vision && ../.venv/bin/python -m uvicorn main:app --port 8003 --reload",
    "sidecar:motion": "cd sidecar/motion && ../../../.venv/bin/python -m uvicorn main:app --port 8004",
    "lint": "eslint src tests",
    "sidecar:agent": "cd ../hannah-agent && bun run dev serve --port 8006"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "transform": {}
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.5",
    "helmet": "^8.2.0",
    "node-pty": "^1.1.0",
    "openai": "^6.39.0",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
