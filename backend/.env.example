PORT=3001
# Interfaz de escucha. 127.0.0.1 = solo esta máquina (recomendado): el acceso desde el
# celular/laptop de la LAN entra por Vite (:5173), que proxea /api y /ws al backend.
# HOST=0.0.0.0 expone el backend (terminal, API keys, memoria) a toda la red: no lo pongas
# salvo que sepas lo que hacés.
HOST=127.0.0.1
NODE_ENV=production
LOG_LEVEL=info

# 1. Speech to Text (Whisper)
# ASR_PROVIDER=cloud usa la API de OpenAI (requiere OPENAI_API_KEY)
# ASR_PROVIDER=local usa el sidecar faster-whisper (npm run sidecar:asr, puerto 8001)
ASR_PROVIDER=local
WHISPER_MODEL=small
# ASR_LANGUAGE=en                   # vacío = auto-detección de idioma
# ASR_DEVICE=auto                   # auto|cuda|cpu — el sidecar cae a CPU si CUDA falla
# TTS_DEVICE=auto                   # ídem para Kokoro (onnxruntime CUDA EP)
# OPENAI_API_KEY=sk-...            # solo necesario con ASR_PROVIDER=cloud
ASR_SIDECAR_URL=http://127.0.0.1:8001

# 2. Dialogue Brain (OpenAI-compatible: Groq, Ollama, OpenRouter...)
LLM_PROVIDER=openai-compatible
LLM_API_KEY=ollama                  # Groq: gsk_... | Ollama: cualquier valor
LLM_BASE_URL=http://localhost:11434/v1
# Ollama is used in THREE places (chat, vision, memory embeddings). If it runs somewhere other
# than localhost:11434 (another port, another machine on your LAN), point all three at it:
# VLM_BASE_URL=http://localhost:11434/v1               # vision (moondream), OpenAI-compatible
# EMBED_URL=http://localhost:11434/api/embeddings       # memory embeddings (native Ollama API)
LLM_MODEL=llama3.1:8b               # Groq: llama-3.1-8b-instant
CONTEXT_TURNS=10

# 3. Audio Output (Kokoro local, npm run sidecar:tts, puerto 8002)
TTS_PROVIDER=kokoro
TTS_SIDECAR_URL=http://127.0.0.1:8002
ELEVENLABS_VOICE_ID=af_heart        # Kokoro voice ID; the TTS language follows the voice prefix.
# af_heart is the ONLY voice that sounds good — that is the whole reason replies are pinned to
# English in llm.protocol. English: af_*/am_* (28 voices) · Spanish: ef_dora/em_* (3, poor).
# You can SPEAK any language regardless: ASR_LANGUAGE empty means auto-detect.

# 4. Percepción Visual. Dos providers:
#   vlm  (default) = modelo de visión local que DESCRIBE la escena (moondream vía Ollama)
#   yolo           = sidecar YOLOv8 (etiquetas de objetos, npm run sidecar:vision, :8003)
VISION_PROVIDER=vlm                 # vlm (moondream via Ollama) | yolo (sidecar :8003) | off (no camera, no vision model)
VLM_MODEL=moondream
VLM_BASE_URL=http://localhost:11434/v1
VISION_SIDECAR_URL=http://127.0.0.1:8003

# 5. Gestos corporales (co-speech). Dos providers con protocolos INCOMPATIBLES:
#   lab   (default) = hannah-motion-lab, texto→movimiento, JSON, :8005
#                     (lo levanta ./hannah, o: cd hannah-motion-lab &&
#                      .venv/bin/python -m uvicorn serve.main:app --port 8005)
#   emage (fallback) = sidecar EMAGE, audio→movimiento, multipart, :8004
#                     (npm run sidecar:motion; requiere ~/PantoMatrix y el venv de la raíz)
MOTION_PROVIDER=lab
MOTION_LAB_URL=http://127.0.0.1:8005
MOTION_EMAGE_URL=http://127.0.0.1:8004
MOTION_ENABLED=true

# ── Las "manos": el sidecar hannah-agent (:8006) ─────────────────────────────────
# Tareas de VARIOS pasos en la máquina ("organize my downloads by type") con un modelo capaz.
# La persona (el 7B local) sigue siendo la ÚNICA voz: el agente nunca habla, ella narra sus
# eventos. OFF por defecto: sin el flag, [TASK:] ni siquiera aparece en el prompt del modelo.
#   ./hannah lo arranca solo si AGENT_ENABLED=true  (npm run sidecar:agent a mano)
#
# ⚠ PRIVACIDAD: el modelo por defecto del agente es GLM 5.3 Flash (Z.ai) vía OpenRouter: barato
#   pero REMOTO. Todo lo que toque una tarea (archivos, salida de comandos, tu pedido) sale de la
#   máquina. "Todo es local" deja de ser cierto para el agente. La key va en el panel ⚙ (Manos) o
#   aquí: ANTHROPIC_API_KEY (perfil por defecto del agente) u OPENROUTER_API_KEY (perfil --openrouter,
#   https://openrouter.ai/keys). El launcher deduce el proveedor por el prefijo (sk-ant- / sk-or-).
#   La cuenta necesita CRÉDITOS: sin ellos cada tarea falla al modelo.
AGENT_ENABLED=false
AGENT_SIDECAR_URL=http://127.0.0.1:8006
# ANTHROPIC_API_KEY=sk-ant-...        # la lee el AGENTE (no el backend); vacío = cada tarea falla al modelo
# OPENROUTER_API_KEY=sk-or-...        # alternativa, con el perfil --openrouter
# HANNAH_AGENT_TOKEN=                 # bearer compartido con el sidecar; el launcher lo genera si está vacío
AGENT_MODE=companion                  # preset de permisos del agente: companion | trusted-project | paranoid
AGENT_NARRATE_PROGRESS_MS=20000       # el progreso se narra como mucho una vez cada N ms por tarea
AGENT_LOST_CONTACT_MS=15000           # sin eventos N ms con tarea viva -> "no sé si terminó" (perdida, no terminada)
AGENT_TIMEBOX_MS=600000               # tope duro por tarea

# ── Los "ojos" que vigilan: el sidecar hannah-sense (:8007) ──────────────────────────
# Vigilancias de pie ("avisame si el entrenamiento se para"): el sidecar MIRA y nunca toca la
# máquina; si hay que arreglar algo, es una tarea del agente, con su permiso y su auditoría.
# OFF por defecto: sin el flag, [WATCH:] ni siquiera se le nombra al modelo, así que no puede
# prometer una vigilancia que después nadie arma.
#   ./hannah lo arranca solo si SENSE_ENABLED=true  (npm run sidecar:sense a mano)
SENSE_ENABLED=false
SENSE_SIDECAR_URL=http://127.0.0.1:8007
# HANNAH_SENSE_TOKEN=                 # bearer compartido con el sidecar; vacío = el sidecar
#                                     # contesta 401 en TODO menos /health (falla cerrado)
SENSE_MAX_WATCHES=2                   # dos y no cinco: cinco a 15 s son 20 subprocesos por minuto, para siempre
SENSE_MIN_PERIOD_MS=15000             # piso del período de muestreo
SENSE_DEBOUNCE_N=3                    # muestras seguidas en falso antes de disparar
SENSE_COOLDOWN_MS=600000              # piso del enfriamiento entre disparos
SENSE_MAX_FIRES=2                     # disparos por ventana; después se desarma y lo DICE
SENSE_BLIND_MS=120000                 # sin muestras N ms -> `blind`, y lo dice ("no lo estoy mirando")
SENSE_ASK_TIMEOUT_MS=900000           # cuánto espera una pregunta nacida de un disparo (P5.2)
SENSE_SSH_ENABLED=false               # el caso remoto (P5.3)
SENSE_SCREEN_ENABLED=false            # la pantalla (P5.5); se entrega apagada a propósito
SENSE_GUI_ENABLED=false               # actuar sobre una GUI (P5.6)
# SENSE_WATCH_TTL_MS=28800000         # cuánto vive una vigilancia armada por voz (8 h); el sidecar corta en 24 h

# Token para usar la UI desde OTRO equipo (modo `./hannah services`). Vacío = se genera solo en
# data/ui-token (0600) y el launcher lo imprime en la URL. Los clientes de esta máquina no lo necesitan.
# HANNAH_UI_TOKEN=
SESSION_TTL_MINUTES=30
# Lista separada por comas (Vite dev server usa https por basic-ssl)
CORS_ORIGIN=https://localhost:5173,http://localhost:5173

# 6. Acciones / control del sistema (OFF por defecto)
#   TOOLS_ENABLED: deja que Hannah ACTÚE (internet, abrir/cerrar apps, comandos por tags).
#   TOOLS_SYSTEM_CONTROL: master flag de la TERMINAL REAL (pty). Gatea run_command, las
#   skills de tipo `terminal` y el panel ⌨. NO hay allowlist de comandos: con esto activo
#   corre CUALQUIER comando; la única red es la confirmación de destructivos (regex DANGER).
TOOLS_ENABLED=false
TOOLS_SYSTEM_CONTROL=false
# Quién corre los comandos LIBRES del modelo ([RUN:]: lo que no es skill ni intención determinista):
#   agent-first (por defecto con AGENT_ENABLED=true) -> el agente (riesgo por niveles, aprobación,
#                auditoría, deshacer); si las manos están apagadas o caídas, cae a free.
#   skills-only -> nunca; el modelo solo tiene skills.
#   free (por defecto sin agente) -> el pty del backend, como siempre (única red: regex DANGER).
# Skills, capa determinista y la terminal del panel siguen en local con cualquier política.
# TOOLS_RUN_POLICY=agent-first

# 7. Memoria de largo plazo (SQLite + recall vectorial por embeddings)
# MEMORY_DB_PATH=                    # vacío = data/memory.db · ':memory:' en los tests
# MEMORY_RECALL=true                 # 'false' apaga el recall vectorial
# MEMORY_RECALL_K=3                  # cuántos recuerdos se inyectan por turno
# EMBED_MODEL=nomic-embed-text
# EMBED_URL=http://localhost:11434/api/embeddings

# 8. Personalidad (solo el carácter; las reglas de tags van aparte en config.js)
# LLM_PERSONA=You are Hannah, a helpful and expressive AI avatar...

# TTS en la nube (solo con TTS_PROVIDER=elevenlabs)
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
