PORT=3001
# Interfaz de escucha. 127.0.0.1 = solo esta máquina (recomendado): el acceso desde el
# celular/laptop de la LAN entra por Vite (:5173), que proxea /api y /ws al backend.
# HOST=0.0.0.0 expone el backend (terminal, API keys, memoria) a toda la red: no lo pongas
# salvo que sepas lo que hacés.
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# 1. Speech to Text (Whisper)
# ASR_PROVIDER=cloud usa la API de OpenAI (requiere OPENAI_API_KEY)
# ASR_PROVIDER=local usa el sidecar faster-whisper (npm run sidecar:asr, puerto 8001)
ASR_PROVIDER=local
WHISPER_MODEL=small
# ASR_LANGUAGE=en                   # vacío = auto-detección de idioma
# ASR_DEVICE=auto                   # auto|cuda|cpu — el sidecar cae a CPU si CUDA falla
# TTS_DEVICE=auto                   # ídem para Kokoro (onnxruntime CUDA EP)
# OPENAI_API_KEY=sk-...            # solo necesario con ASR_PROVIDER=cloud
ASR_SIDECAR_URL=http://127.0.0.1:8001

# 2. Dialogue Brain (OpenAI-compatible: Groq, Ollama, OpenRouter...)
LLM_PROVIDER=openai-compatible
LLM_API_KEY=ollama                  # Groq: gsk_... | Ollama: cualquier valor
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b               # Groq: llama-3.1-8b-instant
CONTEXT_TURNS=10

# 3. Audio Output (Kokoro local, npm run sidecar:tts, puerto 8002)
TTS_PROVIDER=kokoro
TTS_SIDECAR_URL=http://127.0.0.1:8002
ELEVENLABS_VOICE_ID=af_heart        # Kokoro voice ID; the TTS language follows the voice prefix.
# af_heart is the ONLY voice that sounds good — that is the whole reason replies are pinned to
# English in llm.protocol. English: af_*/am_* (28 voices) · Spanish: ef_dora/em_* (3, poor).
# You can SPEAK any language regardless: ASR_LANGUAGE empty means auto-detect.

# 4. Percepción Visual. Dos providers:
#   vlm  (default) = modelo de visión local que DESCRIBE la escena (moondream vía Ollama)
#   yolo           = sidecar YOLOv8 (etiquetas de objetos, npm run sidecar:vision, :8003)
VISION_PROVIDER=vlm
VLM_MODEL=moondream
VLM_BASE_URL=http://localhost:11434/v1
VISION_SIDECAR_URL=http://127.0.0.1:8003

# 5. Gestos corporales (co-speech). Dos providers con protocolos INCOMPATIBLES:
#   lab   (default) = hannah-motion-lab, texto→movimiento, JSON, :8005
#                     (lo levanta ./hannah, o: cd hannah-motion-lab &&
#                      .venv/bin/python -m uvicorn serve.main:app --port 8005)
#   emage (fallback) = sidecar EMAGE, audio→movimiento, multipart, :8004
#                     (npm run sidecar:motion; requiere ~/PantoMatrix y el venv de la raíz)
MOTION_PROVIDER=lab
MOTION_LAB_URL=http://127.0.0.1:8005
MOTION_EMAGE_URL=http://127.0.0.1:8004
MOTION_ENABLED=true

SESSION_TTL_MINUTES=30
# Lista separada por comas (Vite dev server usa https por basic-ssl)
CORS_ORIGIN=https://localhost:5173,http://localhost:5173

# 6. Acciones / control del sistema (OFF por defecto)
#   TOOLS_ENABLED: deja que Hannah ACTÚE (internet, abrir/cerrar apps, comandos por tags).
#   TOOLS_SYSTEM_CONTROL: master flag de la TERMINAL REAL (pty). Gatea run_command, las
#   skills de tipo `terminal` y el panel ⌨. NO hay allowlist de comandos: con esto activo
#   corre CUALQUIER comando; la única red es la confirmación de destructivos (regex DANGER).
TOOLS_ENABLED=false
TOOLS_SYSTEM_CONTROL=false

# 7. Memoria de largo plazo (SQLite + recall vectorial por embeddings)
# MEMORY_DB_PATH=                    # vacío = data/memory.db · ':memory:' en los tests
# MEMORY_RECALL=true                 # 'false' apaga el recall vectorial
# MEMORY_RECALL_K=3                  # cuántos recuerdos se inyectan por turno
# EMBED_MODEL=nomic-embed-text
# EMBED_URL=http://localhost:11434/api/embeddings

# 8. Personalidad (solo el carácter; las reglas de tags van aparte en config.js)
# LLM_PERSONA=You are Hannah, a helpful and expressive AI avatar...

# TTS en la nube (solo con TTS_PROVIDER=elevenlabs)
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
