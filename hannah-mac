#!/usr/bin/env bash
# Hannah - launcher for macOS. Installed as `hannah` by install-mac.sh (symlink in ~/.local/bin).
#   hannah            bring up Ollama + voice/listening/gesture sidecars + backend (+ agent) and open the overlay
#   hannah stop       shut it all down (add --keep-ollama to leave the model server running)
#   hannah doctor     what is running and what is missing
#   hannah uninstall  remove this copy, the app and its data (Ollama and its models stay)
#   hannah hands on   install and enable the hands (the agent + bun, on demand); `off` disables
# Everything runs in the user's session, no admin. Log: $ROOT/.hannah-launch.log
set -u

# ROOT = the folder of this script, following the ~/.local/bin/hannah symlink (macOS has no
# `readlink -f`; a symlink target may be relative to the link's own folder).
self="$0"; while [ -L "$self" ]; do t="$(readlink "$self")"; case "$t" in /*) self="$t" ;; *) self="$(dirname "$self")/$t" ;; esac; done
ROOT="$(cd "$(dirname "$self")" && pwd)"
BACK="$ROOT/backend"; [ -d "$BACK" ] || BACK="$ROOT/hannah-backend"
AGENT="$ROOT/agent"; [ -d "$AGENT" ] || AGENT="$ROOT/hannah-agent"
LAB="$BACK/sidecar/gestures"   # the gesture model, installed as a package; weights in runs/
APP="${HANNAH_APP:-$HOME/Applications/Hannah.app}"
LOG="$ROOT/.hannah-launch.log"
export PATH="$HOME/.local/bin:$HOME/.bun/bin:$ROOT/.tools/node/bin:$PATH"

has() { command -v "$1" >/dev/null 2>&1; }
up() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }
health_path() { case "$1" in 3001) echo /api/v1/health ;; 8006) echo /hannah/v0/health ;; 11434) echo /api/tags ;; *) echo /health ;; esac; }
healthy() { curl -sf -o /dev/null -m 2 "http://127.0.0.1:$1$(health_path "$1")" 2>/dev/null; }
# .env reader (dotenv-like: quotes respected, `#` after a space is a comment)
envval() {
  python3 - "$BACK/.env" "$1" 2>/dev/null <<'PY'
import re, sys
try: lines = open(sys.argv[1], encoding="utf-8").read().splitlines()
except OSError: sys.exit(0)
for line in lines:
    m = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$", line)
    if not m or m.group(1) != sys.argv[2]: continue
    v = m.group(2).strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'": v = v[1:-1]
    else: v = re.split(r"\s+#", v, 1)[0].strip()
    print(v); break
PY
}
agent_on() { [ "$(envval AGENT_ENABLED)" = "true" ]; }
agent_key() {
  local k
  k="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('agent',{}).get('apiKey',''))" "$BACK/data/settings.json" 2>/dev/null)"
  [ -n "$k" ] && { printf '%s' "$k"; return; }
  for v in ANTHROPIC_API_KEY OPENROUTER_API_KEY; do k="$(envval $v)"; [ -n "$k" ] && { printf '%s' "$k"; return; }; done
}
agent_key_var() { case "$(agent_key)" in sk-ant-*) echo ANTHROPIC_API_KEY ;; sk-or-*) echo OPENROUTER_API_KEY ;; *) echo ANTHROPIC_API_KEY ;; esac; }
agent_token() {
  local t
  t="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('agent',{}).get('token',''))" "$BACK/data/settings.json" 2>/dev/null)"
  [ -n "$t" ] || t="$(envval HANNAH_AGENT_TOKEN)"
  if [ -z "$t" ]; then
    t="$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    if grep -q '^#\{0,1\}[[:space:]]*HANNAH_AGENT_TOKEN=' "$BACK/.env" 2>/dev/null; then
      sed -i '' "s|^#\{0,1\}[[:space:]]*HANNAH_AGENT_TOKEN=.*|HANNAH_AGENT_TOKEN=$t|" "$BACK/.env"
    else printf '\nHANNAH_AGENT_TOKEN=%s\n' "$t" >>"$BACK/.env"; fi
    chmod 600 "$BACK/.env" 2>/dev/null
  fi
  printf '%s' "$t"
}
# the watches (hannah-sense, :8007): the .env flag decides, like the hands
sense_on() { [ "$(envval SENSE_ENABLED)" != "false" ]; }
sense_token() {
  local t
  t="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('sense',{}).get('token',''))" "$BACK/data/settings.json" 2>/dev/null)"
  [ -n "$t" ] || t="$(envval HANNAH_SENSE_TOKEN)"
  if [ -z "$t" ]; then
    t="$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    if grep -q '^#\{0,1\}[[:space:]]*HANNAH_SENSE_TOKEN=' "$BACK/.env" 2>/dev/null; then
      sed -i '' "s|^#\{0,1\}[[:space:]]*HANNAH_SENSE_TOKEN=.*|HANNAH_SENSE_TOKEN=$t|" "$BACK/.env"
    else printf '\nHANNAH_SENSE_TOKEN=%s\n' "$t" >>"$BACK/.env"; fi
    chmod 600 "$BACK/.env" 2>/dev/null
  fi
  printf '%s' "$t"
}
watch_counts() {
  curl -sf -m 2 "http://127.0.0.1:8007/health" 2>/dev/null | python3 -c 'import json, sys
try: w = json.load(sys.stdin).get("watches") or {}
except Exception: raise SystemExit(1)
print("%d armed · %d blind · %d suspended" % (w.get("armed", 0), w.get("blind", 0), w.get("suspended", 0)))' 2>/dev/null
}
# our own processes: anchored to this checkout's path (never other apps)
own_pids() { pgrep -u "$(id -u)" -f "$ROOT/" 2>/dev/null; }

doctor() {
  echo "Hannah - macOS"
  echo "  root       : $ROOT"
  printf '  tools      :'; for t in node uv bun ollama; do has $t && printf ' %s✓' $t || printf ' %s✗' $t; done; echo
  printf '  services   :'
  for p in 11434:ollama 8002:tts 8001:asr 8005:motion 3001:backend 8006:agent 8007:sense; do
    if healthy "${p%%:*}"; then printf ' %s✓' "${p##*:}"; elif up "${p%%:*}"; then printf ' %s⚠(port busy)' "${p##*:}"; else printf ' %s✗' "${p##*:}"; fi
  done; echo
  [ -d "$APP" ] && echo "  app        : $APP ✓" || echo "  app        : $APP ✗ (re-run the installer)"
  # an unsigned bundle gets no TCC prompt at all: no signature -> no entitlement -> silent denial
  codesign -d --entitlements - "$APP" 2>/dev/null | grep -q 'security\.device\.audio-input' \
    && echo "  microphone : signed ✓ (com.apple.security.device.audio-input)" \
    || echo "  microphone : ✗ unsigned / entitlement missing - macOS never prompts, so the mic and camera CANNOT work until the app is ad-hoc signed (SETUP.md → Unsigned builds)"
  local helper="$BACK/node_modules/node-pty/prebuilds/darwin-$([ "$(uname -m)" = arm64 ] && echo arm64 || echo x64)/spawn-helper"
  if [ ! -e "$helper" ]; then echo "  terminal   : ⚠ node-pty spawn-helper not found (re-run the installer)"
  elif [ -x "$helper" ]; then echo "  terminal   : node-pty spawn-helper ✓"
  else echo "  terminal   : ✗ spawn-helper is not executable - every TERMINAL_START fails (posix_spawnp failed): chmod +x '$helper'"; fi
  echo "  gestures   : $(curl -sf -m 2 http://127.0.0.1:8005/health 2>/dev/null | python3 -c 'import json,sys
try: h=json.load(sys.stdin)
except Exception: raise SystemExit(1)
err = h.get("warm_up_error")
if err: print("BROKEN on %s: %s (the model loaded, but every /motion answers 500)" % (h.get("device"), err))
elif not h.get("ready", True): print("warming up on %s (first start downloads the text encoder; a minute or two)" % h.get("device"))
else: print("on %s" % h.get("device"))' 2>/dev/null || echo "not running")"
  agent_on && echo "  hands      : AGENT_ENABLED=true · key $([ -n "$(agent_key)" ] && echo ✓ || echo ✗)" || echo "  hands      : off (enable: hannah hands on)"
  if sense_on; then echo "  watches    : $(watch_counts || echo ':8007 is not answering (missing sidecar/sense/.venv? re-run the installer)')"; else echo "  watches    : off (SENSE_ENABLED=false)"; fi
}

stop_all() {
  local keep=""; for a in "$@"; do [ "$a" = "--keep-ollama" ] && keep=1; done
  echo "Hannah - shutting down:"
  # the app (by its bundle path) and everything started from this checkout
  pkill -u "$(id -u)" -f "$APP/Contents/MacOS/Hannah" 2>/dev/null && echo "  overlay ✓"
  for pid in $(own_pids); do kill "$pid" 2>/dev/null; done
  sleep 1; for pid in $(own_pids); do kill -9 "$pid" 2>/dev/null; done
  echo "  backend, sidecars, agent ✓"
  if [ -z "$keep" ]; then pkill -u "$(id -u)" -x ollama 2>/dev/null && echo "  ollama ✓"; else echo "  ollama kept"; fi
}

usage() { sed -n '2,7p' "$self" | sed 's/^# \{0,1\}//'; }
# follow a symlink (macOS has no `readlink -f`)
resolve() { local t="$1"; while [ -L "$t" ]; do local n; n="$(readlink "$t")"; case "$n" in /*) t="$n" ;; *) t="$(dirname "$t")/$n" ;; esac; done; printf '%s' "$t"; }
# Uninstall: what the installer created and nothing else. Ollama and its models are the
# user's (used outside Hannah too), uv and bun are shared tools: they stay.
uninstall_all() {
  local yes="" dry="" a b
  for a in "$@"; do [ "$a" = "--yes" ] && yes=1; [ "$a" = "--dry-run" ] && dry=1; done
  local link="$HOME/.local/bin/hannah" app_data="$HOME/Library/Application Support/hannah-desktop" agent_cfg="$HOME/.config/hannah-agent"
  local link_ours="" tools=""
  [ -L "$link" ] && case "$(resolve "$link")" in "$ROOT"/*) link_ours=1 ;; esac
  # node/npm/npx symlinks the installer pointed at the node it bundled under $ROOT/.tools
  for b in node npm npx; do [ -L "$HOME/.local/bin/$b" ] && case "$(readlink "$HOME/.local/bin/$b")" in "$ROOT"/.tools/*) tools="$tools $HOME/.local/bin/$b" ;; esac; done
  echo "Hannah, uninstall. This removes:"
  echo "  $ROOT"
  echo "      (repos, Python envs, weights, and data/ with your settings, keys and memory)"
  [ -d "$APP" ] && echo "  $APP"
  [ -n "$link_ours" ] && echo "  $link (symlink)"
  [ -n "$tools" ] && echo "  $tools (symlinks to the node the installer bundled)"
  [ -d "$app_data" ] && echo "  $app_data (window position)"
  [ -d "$agent_cfg" ] && echo "  $agent_cfg"
  echo "Kept: Ollama and its models, uv, bun."
  [ -n "$dry" ] && { echo "(dry run: nothing removed)"; return 0; }
  if [ -z "$yes" ]; then
    printf 'Type "yes" to remove all of that: '
    read -r a </dev/tty || a=""
    [ "$a" = "yes" ] || { echo "cancelled, nothing touched"; return 1; }
  fi
  stop_all --keep-ollama >/dev/null 2>&1
  [ -n "$link_ours" ] && rm -f "$link"
  # shellcheck disable=SC2086
  [ -n "$tools" ] && rm -f $tools
  rm -rf "$APP" "$app_data" "$agent_cfg" "$ROOT"
  echo "Hannah uninstalled. To come back: curl -fsSL https://vanthlabs.org/install-mac.sh | bash"
}

set_env() {   # set_env KEY VALUE in the backend .env (adds the line if missing)
  if grep -q "^#\{0,1\}[[:space:]]*$1=" "$BACK/.env" 2>/dev/null; then sed -i '' "s|^#\{0,1\}[[:space:]]*$1=.*|$1=$2|" "$BACK/.env"
  else printf '\n%s=%s\n' "$1" "$2" >>"$BACK/.env"; fi
}
# The hands, on demand: the installer no longer brings the agent (43 MB of repo, 870 MB of
# dependencies and bun) because it is off by default.
hands_cmd() {
  case "${1:-}" in
    on)
      if [ ! -d "$AGENT/.git" ]; then
        echo "Hannah: downloading the agent to $AGENT"
        git clone -q https://github.com/Vanth-Labs/agent.git "$AGENT" || { echo "hannah: could not clone the agent" >&2; return 1; }
      fi
      export BUN_INSTALL="$HOME/.bun"; export PATH="$BUN_INSTALL/bin:$PATH"
      if ! has bun; then
        echo "Hannah: installing bun in ~/.bun (your user only)"
        local t; t="$(mktemp)"
        curl -fsSL --proto '=https' --tlsv1.2 -o "$t" https://bun.sh/install && bash "$t" >/dev/null 2>&1; rm -f "$t"
        has bun || { echo "hannah: bun did not install (https://bun.sh)" >&2; return 1; }
      fi
      echo "Hannah: agent dependencies (bun install, about a minute)"
      ( cd "$AGENT" && bun install >/dev/null 2>&1 ) || { echo "hannah: bun install failed in $AGENT" >&2; return 1; }
      [ -f "$HOME/.config/hannah-agent/hannah-agent.jsonc" ] || ( cd "$AGENT" && scripts/install-profile.sh --openrouter >/dev/null 2>&1 ) || true
      set_env AGENT_ENABLED true
      echo "Hands on (AGENT_ENABLED=true)."
      echo "Missing: the provider key (Anthropic or OpenRouter): the overlay's settings -> Hands, or ANTHROPIC_API_KEY / OPENROUTER_API_KEY in $BACK/.env."
      echo "Restart so the agent starts: hannah stop && hannah"
      ;;
    off)
      set_env AGENT_ENABLED false
      echo "Hands off (AGENT_ENABLED=false). Nothing is removed; 'hannah hands on' enables them again. Applies on the next start."
      ;;
    *) echo "Usage: hannah hands on|off" >&2; return 2 ;;
  esac
}

case "${1:-}" in
  "") ;;
  doctor) doctor; exit 0 ;;
  stop) shift; stop_all "$@"; exit 0 ;;
  uninstall) shift; uninstall_all "$@"; exit $? ;;
  hands) shift; hands_cmd "$@"; exit $? ;;
  -h|--help|help) usage; exit 0 ;;
  *) echo "hannah: unknown command: $1" >&2; usage >&2; exit 2 ;;
esac

[ -f "$BACK/.env" ] || { echo "hannah: $BACK/.env is missing - run the installer first"; exit 1; }
echo "[hannah] $(date '+%F %T') up" >>"$LOG"
healthy 11434 || { has ollama && (nohup ollama serve >>"$LOG" 2>&1 &); }
PY="$BACK/sidecar/.venv/bin/python"
up 8002 || ( cd "$BACK/sidecar/tts" && TTS_DEVICE=cpu nohup "$PY" -m uvicorn main:app --port 8002 >>"$LOG" 2>&1 & )
up 8001 || ( cd "$BACK/sidecar/asr" && ASR_DEVICE=cpu nohup "$PY" -m uvicorn main:app --port 8001 >>"$LOG" 2>&1 & )
# gestures: Apple's GPU (MPS) if there is one, else the CPU - never skipped
up 8005 || ( cd "$LAB" && [ -x .venv/bin/python ] && MOTION_DEVICE=auto MOTIONLAB_RUNS="$LAB/runs" nohup .venv/bin/python -m motionlab.serve --port 8005 >>"$LOG" 2>&1 & )
# the watches, before the backend so its capability probe finds them
if sense_on && [ -x "$BACK/sidecar/sense/.venv/bin/python" ]; then
  up 8007 || ( cd "$BACK/sidecar/sense" && export HANNAH_SENSE_TOKEN="$(sense_token)" SENSE_MAX_WATCHES="$(envval SENSE_MAX_WATCHES)" SENSE_MIN_PERIOD_MS="$(envval SENSE_MIN_PERIOD_MS)" SENSE_DEBOUNCE_N="$(envval SENSE_DEBOUNCE_N)" SENSE_BLIND_MS="$(envval SENSE_BLIND_MS)" && nohup .venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8007 >>"$LOG" 2>&1 & )
fi
if agent_on && has bun && [ -d "$AGENT" ]; then
  up 8006 || ( cd "$AGENT" && tok="$(agent_token)" \
    && export HANNAH_AGENT_TOKEN="$tok" HANNAH_AGENT_SERVER_PASSWORD="$tok" HANNAH_AGENT_MAX_MODE="$(envval AGENT_MODE)" "$(agent_key_var)=$(agent_key)" \
              HANNAH_AGENT_DENY_DIRS="$BACK/data" \
    && nohup bun run dev serve --port 8006 >>"$LOG" 2>&1 & )
fi
up 3001 || ( cd "$BACK" && nohup node src/server.js >>"$LOG" 2>&1 & )
for _ in $(seq 1 60); do healthy 3001 && break; sleep 1; done
healthy 3001 || { echo "hannah: the backend did not come up - see $LOG"; exit 1; }
for p in 8001 8002 8005 8006 8007; do up "$p" && ! healthy "$p" && echo "[hannah] WARNING: port $p is busy with something else" >>"$LOG"; done
if [ -d "$APP" ]; then
  # the packaged app serves its own frontend and talks to the backend at localhost:3001;
  # the open command also just focuses it if it is already running
  open -a "$APP"
else
  echo "hannah: $APP not found - re-run the installer, or open http://localhost:3001/test-client.html"
fi
