#!/usr/bin/env bash
# Hannah — lanzador de la compañera flotante (overlay).
# Portable: deriva su ubicación (sin rutas absolutas), autodetecta monitor y navegador.
# Levanta (si faltan) Ollama + sidecars + backend + Vite, abre el frontend en modo-app
# y lo coloca flotante/encima. En Hyprland usa hyprctl; en otros entornos degrada a
# ventana normal (el adaptador X11/otros se añade aparte).
set -u
# Solo Linux: usa ss, /proc, ip y los adaptadores X11/Hyprland. En macOS/Windows la app se
# arranca a mano (ver README); antes el launcher "funcionaba" ahí a medias y duplicaba servicios.
[ "$(uname -s)" = Linux ] || { echo "hannah: este launcher es solo para Linux (macOS/Windows: ver README)" >&2; exit 1; }

# Raíz del proyecto = carpeta de este script (portable).
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"   # catalog_check relee este archivo
ROOT="$(cd "$(dirname "$SELF")" && pwd)"
# Node privado del instalador (cuando el del sistema no es un LTS con binarios precompilados):
# primero en el PATH, el del sistema no se toca.
[ -x "$ROOT/.tools/node/bin/node" ] && export PATH="$ROOT/.tools/node/bin:$PATH"
# Cada repo hermano tiene DOS nombres y puede estar en DOS sitios, y hay que probar los cuatro:
#   - nombre: el repo trae backend/, frontend/, desktop/; el instalador clona motion-model/ y agent/ al lado; un
#     checkout de desarrollo conserva los de upstream (backend/, frontend/, motion-model/…).
#   - sitio: instalado, los hermanos quedan JUNTO a este script; en desarrollo el launcher vive
#     dentro de workspace/, o sea un nivel por DEBAJO de ellos.
# Gana el primero que exista. Sin esto, en un checkout de desarrollo BACK/FRONT/LAB/DESK/AGENT
# apuntaban todos a carpetas inexistentes: cada `cd "$BACK"` fallaba y el servicio no arrancaba
# sin decir por qué. `cd -P` porque la ruta se compara luego contra /proc/<pid>/cwd, que viene
# con los symlinks ya resueltos.
sibling() {   # sibling <instalado> <dev> [optional]: con "optional" no avisa si falta
  local inst="$1" dev="$2" d
  for d in "$ROOT/$inst" "$ROOT/$dev" "$ROOT/../$inst" "$ROOT/../$dev"; do
    [ -d "$d" ] && { (cd -P "$d" && pwd); return 0; }
  done
  [ "${3:-}" = optional ] || echo "hannah: no encuentro el repo '$inst' (ni '$dev') junto a $ROOT ni en su padre" >&2
  printf '%s' "$ROOT/$inst"   # ruta nominal: los mensajes siguientes siguen nombrando algo
  return 1
}
BACK="$(sibling backend hannah-backend)"
FRONT="$(sibling frontend hannah-frontend optional)"   # opcional: el AppImage lleva su frontend
LAB="$(sibling motion-model hannah-motion-lab)"
LOG="$ROOT/.hannah-launch.log"
PROFILE="${HANNAH_PROFILE:-$HOME/.hannah-browser}"     # perfil Firefox/Zen (Gecko)
MONITOR="${HANNAH_MONITOR:-}"                            # vacío = autodetectar el enfocado
URL="http://localhost:5173/?overlay=1"
DESK="$(sibling desktop hannah-desktop)"
# Cómo se abre el overlay:
#   app     (por defecto) -> la app Electron: widget flotante, se coloca sola, funciona igual
#                            en GNOME/KDE/XFCE/Hyprland (fuerza XWayland).
#   browser               -> el frontend en un navegador en modo-app; más liviano, pero para
#                            que flote depende de hyprctl/wmctrl y en Wayland nativo no puede.
APPIMAGE="${HANNAH_APPIMAGE:-$HOME/.local/bin/Hannah.AppImage}"
resolve_mode() {   # app -> appimage (o navegador) si no hay Electron de desarrollo instalado
  local m="${HANNAH_MODE:-app}"
  if [ "$m" = app ] && [ ! -x "$DESK/node_modules/electron/dist/electron" ]; then
    if [ -x "$APPIMAGE" ]; then m=appimage; else m=browser; fi
  fi
  printf '%s' "$m"
}
MODE="$(resolve_mode)"
# Vite solo hace falta cuando el frontend se sirve desde el repo: app de desarrollo, navegador,
# services, o el AppImage con HANNAH_DEV=1 (para probar cambios del frontend sin release). El
# AppImage del instalador lleva su propio frontend empaquetado, como la app de Mac y Windows.
needs_vite() { [ "$MODE" != appimage ] || [ -n "${HANNAH_DEV:-}" ]; }

# ── El catálogo de servicios: UNA sola lista ──────────────────────────────────
# Puerto, nombre y quién lo arranca. Había TRES listas de puertos escritas a mano —la del apagado
# (SERVICES), el bloque de arranque y el bucle del doctor— y ya habían divergido: 8003 figuraba en
# la del apagado y en ninguna de las otras dos. Esa deriva no falla, desaparece: un puerto que se
# reapea y nadie arranca es un servicio que no está y del que nadie se entera. Todo lo que sigue
# (apagado, arranque, doctor, aviso de puertos ocupados) se deriva de acá, y catalog_check avisa
# si vuelven a separarse.
#   auto   -> lo arranca este script; catalog_check EXIGE que aparezca en el bloque de arranque.
#   manual -> proveedor alternativo que no arranca nadie solo (visión :8003 y EMAGE :8004 solo se
#             usan con VISION_PROVIDER=yolo / MOTION_PROVIDER=emage, a mano). Figuran igual para
#             poder apagarlos y para que el doctor los nombre en vez de ignorarlos.
# Ollama (:11434) queda FUERA a propósito: es un servicio del sistema, puede correr como otro
# usuario y no se apaga por puerto sino descargando sus modelos (ver stop_ollama).
SERVICE_CATALOG="3001:backend:auto 5173:vite:auto 8001:asr:auto 8002:tts:auto 8003:vision:manual 8004:emage:manual 8005:motion:auto 8006:agent:auto 8007:sense:auto"
# Las tres vistas del catálogo, derivadas una sola vez: "puerto:nombre" para el apagado, los
# puertos sueltos, y solo los que arranca el launcher (los únicos de los que tiene sentido decir
# "ese servicio no arrancó").
SERVICES=""; SERVICE_PORTS=""; AUTO_PORTS=""
for _s in $SERVICE_CATALOG; do
  _rest="${_s#*:}"
  SERVICES="$SERVICES ${_s%%:*}:${_rest%%:*}"
  SERVICE_PORTS="$SERVICE_PORTS ${_s%%:*}"
  [ "${_rest#*:}" = auto ] && AUTO_PORTS="$AUTO_PORTS ${_s%%:*}"
done
SERVICES="${SERVICES# }"; SERVICE_PORTS="${SERVICE_PORTS# }"; AUTO_PORTS="${AUTO_PORTS# }"
unset _s _rest

# El chequeo que impide que vuelvan a divergir: lee el bloque de arranque de ESTE archivo y lo
# compara con el catálogo, en los dos sentidos. Un puerto `auto` que nadie arranca es un servicio
# reapeado y nunca levantado; un `up <puerto>` que no está en el catálogo es un servicio que
# `hannah stop` no apaga y que el doctor no mira. Devuelve vacío si coinciden.
catalog_check() {
  local started p bad=""
  started="$(sed -n '/^# ── Servicios (idempotente)/,/^# Sección crítica terminada/p' "$SELF" \
    | grep -oE '\bup [0-9]{3,5}\b' | awk '{print $2}' | sort -u)"
  for p in $AUTO_PORTS; do
    printf '%s\n' "$started" | grep -qx "$p" || bad="$bad $p(en el catálogo, nadie lo arranca)"
  done
  for p in $started; do
    case " $AUTO_PORTS " in *" $p "*) ;; *) bad="$bad $p(se arranca, no está en el catálogo)" ;; esac
  done
  printf '%s' "${bad# }"
}

up() { ss -ltn 2>/dev/null | grep -q ":$1 "; }
# ¿Hay ALGO nuestro respondiendo ahí? "Puerto ocupado" no es "servicio sano": otra app en 8002
# dejaba a Hannah muda con el doctor en ✓. Cada servicio tiene su ruta de salud.
health_path() { case "$1" in 3001) echo /api/v1/health ;; 8006) echo /hannah/v0/health ;; 11434) echo /api/tags ;; 5173) echo / ;; *) echo /health ;; esac; }
# `localhost`, no 127.0.0.1: Vite escucha en `localhost`, que en muchas maquinas resuelve solo a
# IPv6 ([::1]), y sondeando 127.0.0.1 el doctor lo daba por "puerto ocupado por otra cosa".
# curl prueba las dos familias.
healthy() { curl -sf -o /dev/null -m 2 "http://localhost:$1$(health_path "$1")" 2>/dev/null || curl -skf -o /dev/null -m 2 "https://localhost:$1$(health_path "$1")" 2>/dev/null; }
# Puertos ocupados por algo que NO responde como el servicio esperado: se avisa en vez de callar.
warn_squatters() {
  local p
  for p in "$@"; do up "$p" && ! healthy "$p" && echo "[hannah] OJO: el puerto $p está ocupado por otra cosa (no responde $(health_path "$p")) — ese servicio no arrancó" >>"$LOG"; done
  return 0
}
# El overlay necesita Vite en HTTP (HANNAH_HTTP=1). Si hay un Vite en 5173 pero en HTTPS
# (p.ej. `npm run dev` a mano), el puerto figura ocupado y antes nos quedábamos esperando
# 60s a una URL http que nunca responde. Esto lo detecta y lo dice.
vite_http_ok() { curl -sf -o /dev/null -m 2 "http://localhost:5173/" 2>/dev/null; }
# bun (el agente) se instala en ~/.bun/bin, que no está en el PATH de un atajo de teclado
# (Super+H no pasa por el perfil del shell). Igual en Linux y macOS.
[ -d "$HOME/.bun/bin" ] && case ":$PATH:" in *":$HOME/.bun/bin:"*) ;; *) PATH="$HOME/.bun/bin:$PATH" ;; esac

has() { command -v "$1" >/dev/null 2>&1; }
# Una variable del .env del backend (sin exportar todo: solo la que se pide). Vacío si no está.
# Lee KEY del .env como lo hace dotenv: comillas simples/dobles respetadas (un token con `#`
# o `\` llega entero), comentario solo tras un espacio en valores sin comillas.
envval() {
  python3 - "$BACK/.env" "$1" 2>/dev/null <<'PY'
import re, sys
try: lines = open(sys.argv[1], encoding="utf-8").read().splitlines()
except OSError: sys.exit(0)
for line in lines:
    m = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$", line)
    if not m or m.group(1) != sys.argv[2]: continue
    v = m.group(2).strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'": v = v[1:-1]
    else: v = re.split(r"\s+#", v, 1)[0].strip()
    print(v); break
PY
}
AGENT="$(sibling agent hannah-agent optional)"   # opcional: lo trae `hannah hands on`
agent_on() { [ "$(envval AGENT_ENABLED)" = "true" ]; }
# El bearer entre backend y agente. Si el .env no lo trae se genera aquí y se escribe en el
# .env (0600): sin él, cualquier proceso local podía encargarle tareas al agente.
agent_token() {
  local t
  # Misma precedencia que el backend: lo guardado en el panel ⚙ (settings.json) manda sobre el .env.
  t="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('agent',{}).get('token',''))" "$BACK/data/settings.json" 2>/dev/null)"
  [ -n "$t" ] || t="$(envval HANNAH_AGENT_TOKEN)"
  if [ -z "$t" ]; then
    t="$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    if grep -q '^#\?[[:space:]]*HANNAH_AGENT_TOKEN=' "$BACK/.env" 2>/dev/null; then
      sed -i "s|^#\?[[:space:]]*HANNAH_AGENT_TOKEN=.*|HANNAH_AGENT_TOKEN=$t|" "$BACK/.env"
    else printf '\nHANNAH_AGENT_TOKEN=%s\n' "$t" >>"$BACK/.env"; fi
    chmod 600 "$BACK/.env" 2>/dev/null
    echo "[hannah] HANNAH_AGENT_TOKEN generado en $BACK/.env" >>"$LOG"
  fi
  printf '%s' "$t"
}
# La key del modelo del agente: lo que el usuario guardó en el panel ⚙ (data/settings.json)
# manda sobre el .env — es el mismo orden de precedencia que usa el backend.
agent_key() {
  local k
  k="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('agent',{}).get('apiKey',''))" "$BACK/data/settings.json" 2>/dev/null)"
  [ -n "$k" ] && { printf '%s' "$k"; return; }
  k="$(envval ANTHROPIC_API_KEY)"; [ -n "$k" ] && { printf '%s' "$k"; return; }
  envval OPENROUTER_API_KEY
}
# El proveedor se deduce del prefijo de la key: sk-ant-… es Anthropic, sk-or-… es OpenRouter.
# El agente lee la key de la variable de SU proveedor, así que hay que exportar la correcta.
agent_key_var() {
  case "$(agent_key)" in sk-ant-*) echo ANTHROPIC_API_KEY ;; *) echo OPENROUTER_API_KEY ;; esac
}

# Los "ojos" (hannah-sense, :8007), con el mismo trato que las manos: la bandera del .env manda.
sense_on() { [ "$(envval SENSE_ENABLED)" != "false" ]; }
# El bearer entre el backend y :8007, misma precedencia que el del agente (panel ⚙ → .env →
# generado y escrito al .env, 0600). Acá el token no es opcional ni en desarrollo: sin él el
# sidecar contesta 401 en TODO menos /health, así que arrancarlo sin generarlo sería dejar arriba
# un proceso que muestrea para nadie.
sense_token() {
  local t
  t="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('sense',{}).get('token',''))" "$BACK/data/settings.json" 2>/dev/null)"
  [ -n "$t" ] || t="$(envval HANNAH_SENSE_TOKEN)"
  if [ -z "$t" ]; then
    t="$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    if grep -q '^#\?[[:space:]]*HANNAH_SENSE_TOKEN=' "$BACK/.env" 2>/dev/null; then
      sed -i "s|^#\?[[:space:]]*HANNAH_SENSE_TOKEN=.*|HANNAH_SENSE_TOKEN=$t|" "$BACK/.env"
    else printf '\nHANNAH_SENSE_TOKEN=%s\n' "$t" >>"$BACK/.env"; fi
    chmod 600 "$BACK/.env" 2>/dev/null
    echo "[hannah] HANNAH_SENSE_TOKEN generado en $BACK/.env" >>"$LOG"
  fi
  printf '%s' "$t"
}
# "¿Sigue mirando?", contestado sin abrir el HUD. Sale del /health del sidecar —la única ruta sin
# token, que existe justo para esto— y cuenta FILAS, no configuración: un proceso vivo que dejó de
# muestrear se ve como `ciega`, que es la diferencia que importa. Vacío = no contestó.
watch_counts() {
  local body
  body="$(curl -sf -m 2 "http://127.0.0.1:8007/health" 2>/dev/null)" || return 1
  printf '%s' "$body" | python3 -c 'import json, sys
try: w = json.load(sys.stdin).get("watches") or {}
except Exception: raise SystemExit(1)
print("%d armada(s) · %d ciega(s) · %d suspendida(s)" % (w.get("armed", 0), w.get("blind", 0), w.get("suspended", 0)))' 2>/dev/null
}

# ── `hannah doctor` — diagnóstico del entorno ─────────────────────────────────
# Dice si el overlay va a poder flotar acá y, si no, qué falta. Es lo primero que conviene
# correr en una máquina nueva: antes esto fallaba en silencio (ventana normal, sin explicar).
doctor() {
  local de="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-desconocido}}"
  local sess="${XDG_SESSION_TYPE:-desconocido}"
  echo "Hannah — diagnóstico del entorno"
  echo "  escritorio : $de"
  echo "  sesión     : $sess$([ -n "${WAYLAND_DISPLAY:-}" ] && echo ' (Wayland)')$([ -n "${DISPLAY:-}" ] && echo " · X disponible en \$DISPLAY=$DISPLAY")"
  printf '  herramientas:'
  for t in hyprctl kdotool wmctrl xdotool swaymsg; do has "$t" && printf ' %s' "$t"; done
  echo
  printf '  repos      :'
  local r n d
  for r in "backend:$BACK" "frontend:$FRONT" "motion:$LAB" "desktop:$DESK" "agent:$AGENT"; do
    n="${r%%:*}"; d="${r#*:}"
    if [ -d "$d" ]; then printf ' %s✓' "$n"
    elif [ "$n" = frontend ] && ! needs_vite; then printf ' frontend–'
    elif [ "$n" = agent ] && ! agent_on; then printf ' agent–'
    else printf ' %s✗(%s)' "$n" "$d"; fi
  done
  echo
  { [ ! -d "$FRONT" ] && ! needs_vite; } && echo "               – frontend: no hace falta, el AppImage lleva el suyo (HANNAH_DEV=1 lo usaría)"
  { [ ! -d "$AGENT" ] && ! agent_on; } && echo "               – agent: las manos se instalan con 'hannah hands on'"
  printf '  servicios  :'
  # Del catálogo, no de una tercera lista: 8003 faltaba acá y por eso nadie notó durante meses
  # que se apagaba un servicio que no se arrancaba. Ollama se agrega al vuelo (no está en el
  # catálogo porque no se apaga por puerto).
  local port role name manual_down=""
  for r in $SERVICE_CATALOG 11434:ollama:auto; do
    port="${r%%:*}"; name="${r#*:}"; role="${name#*:}"; name="${name%%:*}"
    if [ "$port" = 5173 ] && ! needs_vite && ! up 5173; then printf ' vite–'
    elif healthy "$port"; then printf ' %s✓' "$name"
    elif up "$port"; then printf ' %s⚠(puerto ocupado por otra cosa)' "$name"
    elif [ "$role" = manual ]; then printf ' %s–' "$name"; manual_down=1
    else printf ' %s✗' "$name"; fi
  done
  echo
  [ -n "$manual_down" ] && echo "               – proveedor alternativo: no lo arranca el launcher (npm run sidecar:<nombre>)"
  # La deriva entre las tres listas, dicha en voz alta. Callar cuando coinciden dejaría al lector
  # sin saber que alguien lo comprueba, que es la mitad del valor de comprobarlo.
  local drift; drift="$(catalog_check)"
  if [ -n "$drift" ]; then
    echo "  catálogo   : ⚠️  INCONSISTENTE — $drift"
    echo "               (SERVICE_CATALOG y el bloque de arranque de este script no coinciden)"
    echo "hannah: catálogo de servicios inconsistente: $drift" >&2
  else
    echo "  catálogo   : $(printf '%s\n' $SERVICE_PORTS | wc -l) servicios; apagado, arranque y diagnóstico coinciden ✓"
  fi
  echo
  if agent_on; then
    printf '  manos      : AGENT_ENABLED=true ·'
    has bun && printf ' bun %s' "$(bun --version 2>/dev/null)" || printf ' bun FALTA (https://bun.sh)'
    [ -f "$HOME/.config/hannah-agent/config.jsonc" ] || [ -f "$HOME/.config/hannah-agent/hannah-agent.jsonc" ] \
      && printf ' · perfil instalado' || printf ' · perfil FALTA (hannah-agent/scripts/install-profile.sh, o --openrouter)'
    [ -n "$(agent_key)" ] && printf ' · key ✓' || printf ' · key FALTA: panel ⚙, o ANTHROPIC_API_KEY / OPENROUTER_API_KEY en .env (cada tarea fallará al modelo)'
    echo
  else
    echo "  manos      : apagadas (AGENT_ENABLED=false): Hannah conversa y ejecuta comandos simples, sin tareas de varios pasos. Encender: hannah hands on"
  fi
  # "¿Sigue mirando?" tiene que poder contestarse acá: el contrato sense.v1 no emite latido, así
  # que cuatro horas de silencio y cuatro horas de ceguera se ven igual desde afuera. Lo que las
  # separa es este contador.
  if sense_on; then
    local counts
    if counts="$(watch_counts)"; then echo "  vigilancia : $counts"
    else echo "  vigilancia : :8007 no contesta — NO está mirando nada (mirá $LOG; ¿falta el venv de sidecar/sense? re-ejecutá install.sh)"; fi
  else
    echo "  vigilancia : apagada (SENSE_ENABLED=false) — no puede quedarse mirando nada"
  fi
  echo

  local dl; dl=$(printf '%s' "$de" | tr '[:upper:]' '[:lower:]')
  if has hyprctl && [[ "$dl" == *hyprland* ]]; then
    echo "  ✅ Overlay COMPLETO (Hyprland): flota, se fija encima y se mueve entre monitores."
    echo "     Usá:  ./hannah   (o Super+H)"
  elif has kdotool && [[ "$dl" == *kde* || "$dl" == *plasma* ]]; then
    echo "  ✅ Overlay COMPLETO (KDE vía kdotool)."
    echo "     Recomendado: la app de escritorio (hannah-desktop)."
  elif [ -n "${DISPLAY:-}" ] && { has wmctrl || has xdotool; }; then
    echo "  ✅ Overlay COMPLETO (X11/XWayland con $(has wmctrl && echo wmctrl || echo xdotool))."
    [ -n "${WAYLAND_DISPLAY:-}" ] && echo "     Sesión Wayland: la ventana corre bajo XWayland, por eso funciona."
    echo "     Recomendado: la app de escritorio (hannah-desktop), que fuerza XWayland."
  elif [ -n "${DISPLAY:-}" ]; then
    echo "  🟡 Overlay PARCIAL: la app de escritorio flota sola (XWayland), pero falta una"
    echo "     herramienta para moverla/fijarla por voz."
    echo "     Instalá:  wmctrl   (Debian/Ubuntu: sudo apt install wmctrl · Arch: sudo pacman -S wmctrl"
    echo "               Fedora: sudo dnf install wmctrl)"
    [[ "$dl" == *kde* || "$dl" == *plasma* ]] && echo "     En KDE, aún mejor: kdotool."
  else
    echo "  ⚠️  Sin vía de control de ventanas (Wayland nativo sin XWayland)."
    echo "     Usá la app de escritorio (hannah-desktop): fuerza XWayland y flota igual."
    [[ "$dl" == *gnome* ]] && echo "     Nota: GNOME en Wayland nativo no deja que las apps se pongan encima (es su diseño)."
  fi
  echo
  echo "  Documentación: SETUP.md"
}
usage() {
  cat <<'USAGE'
Uso: hannah [comando]
  (nada)                             levanta lo que falte y abre el overlay
  stop [--keep-ollama] [--dry-run]   apaga todo y libera la VRAM
  doctor                             diagnostica el entorno y lo que falta
  uninstall [--yes] [--dry-run]      desinstala esta copia (Ollama, sus modelos y uv se quedan)
  hands on|off                       instala y enciende las manos (agente + bun, bajo demanda), o las apaga
USAGE
}
case "${1:-}" in
  ""|stop|doctor|uninstall|hands) ;;
  -h|--help|help) usage; exit 0 ;;
  *) echo "hannah: comando desconocido: $1" >&2; usage >&2; exit 2 ;;
esac
[ "${1:-}" = "doctor" ] && { doctor; exit 0; }

# ── `hannah stop` — apagar TODO lo del proyecto ───────────────────────────────
# Se mata por PUERTO y por patrón, no por una lista de PIDs guardada, a propósito: así se
# lleva también los sidecars HUÉRFANOS de corridas anteriores. Eso no es teórico — había uno
# de una corrida vieja ocupando 2.4GB de VRAM sin que nada lo registrara.
# SERVICES (puerto:nombre) sale del catálogo de arriba; la lista suelta que vivía acá es la que
# se había quedado sin 8007 y de más con 8003.

# El proyecto son los repos ya resueltos, NO todo lo que cuelga de $ROOT. En un checkout de
# desarrollo $ROOT es workspace/ y los servicios corren desde sus hermanos, así que el límite
# viejo no reconocía ni uno: `hannah stop` los daba por AJENOS y no apagaba nada. Se listan los
# repos uno a uno en vez de subir a $ROOT/..: el padre puede ser $HOME, y ensanchar ahí el radio
# de la matanza es justo lo que is_safe_target/argv0_in_project existen para impedir.
PROJECT_DIRS=("$ROOT" "$BACK" "$FRONT" "$LAB" "$DESK" "$AGENT")
in_project() {
  local p="$1" d
  for d in "${PROJECT_DIRS[@]}"; do case "$p" in "$d"|"$d"/*) return 0 ;; esac; done
  return 1
}
# Las rutas entran en un ERE de pgrep: si la de instalación tiene ( ) + . etc., el patrón se
# corrompe y el apagado deja de encontrar nada, en silencio.
esc_re() { printf '%s' "$1" | sed 's/[][\\.^$*+?(){}|]/\\&/g'; }
PROJECT_RE="$(for d in "${PROJECT_DIRS[@]}"; do printf '|%s' "$(esc_re "$d")"; done)"
PROJECT_RE="(${PROJECT_RE#|})"
DESK_RE="$(esc_re "$DESK")"

port_pid() { ss -ltnp 2>/dev/null | grep ":$1 " | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -1; }

DRY=""   # con --dry-run solo se lista lo que se mataría

# Descendientes de un PID, recursivo y de las hojas hacia la raíz.
descendants() {
  local kid
  for kid in $(pgrep -P "$1" 2>/dev/null); do descendants "$kid"; echo "$kid"; done
}

# ¿Es seguro matar este PID? NUNCA init ni un ancestro nuestro.
# Esto existe por un incidente real: la versión anterior mataba el GRUPO de procesos
# (kill -TERM -PGID) y, como un servicio compartía grupo con quien lo lanzó, se llevó puesta
# la sesión de Hyprland y cerró la sesión del usuario. Matar hacia arriba no es una opción.
is_safe_target() {
  local pid="$1" p=$$
  [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null || return 1
  while [ -n "$p" ] && [ "$p" -gt 1 ]; do
    [ "$p" = "$pid" ] && return 1          # es un ancestro del launcher: intocable
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
  done
  return 0
}

# ¿El EJECUTABLE del proceso está dentro del repo? Se mira argv[0], no la línea entera:
# que una ruta del proyecto aparezca como ARGUMENTO no lo hace un proceso del proyecto.
# Sin esto, `nvim hannah-backend/sidecar/tts/main.py` o `tail -f .../sidecar/asr/log` entraban
# en la matanza — o sea, el editor del usuario con cambios sin guardar.
argv0_in_project() {
  local pid="$1" a0 cwd
  a0="$(tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | head -1)"
  [ -n "$a0" ] || return 1
  case "$a0" in
    /*) : ;;
    *) cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null)" || return 1; a0="$cwd/$a0" ;;
  esac
  # Chromium REESCRIBE su argv: /proc/pid/cmdline llega como una sola cadena con espacios
  # ("/ruta/electron --no-sandbox ..."), así que si no es ejecutable tal cual, se prueba con
  # la primera palabra. Sin esto, la app no entraba en el apagado y sobrevivía al stop.
  [ -x "$a0" ] || a0="${a0%% *}"
  # tiene que existir de verdad: si no, un shell con cwd dentro del repo pasaría el filtro
  [ -x "$a0" ] || return 1
  in_project "$a0"
}

# Para los servicios que escuchan un puerto nuestro alcanza con que CORRAN desde el repo
# (node y python del sistema tienen su binario fuera). Se mira cwd o argv[0]; ya no vale que
# la ruta aparezca en cualquier parte de la línea de comandos.
belongs_to_project() {
  local pid="$1" cwd
  cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null)"
  in_project "$cwd" && return 0
  argv0_in_project "$pid"
}

# Mata un proceso y SUS DESCENDIENTES (nunca el grupo, ver is_safe_target).
kill_tree() {
  local pid="$1" p
  kill -0 "$pid" 2>/dev/null || return 1
  is_safe_target "$pid" || return 1
  [ -n "$DRY" ] && return 0
  for p in $(descendants "$pid") "$pid"; do kill -TERM "$p" 2>/dev/null; done
  for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.25; done
  for p in $(descendants "$pid") "$pid"; do kill -KILL "$p" 2>/dev/null; done
  return 0
}

# Ollama: lo que retiene VRAM son los MODELOS cargados, no el servidor. `ollama stop` los
# descarga por la API y funciona SIN root — que es justo lo que hace falta, porque acá el
# servicio corre bajo el usuario `ollama` (systemd) y un pkill del usuario no tiene permiso.
# Antes eso fallaba en silencio y el script igual decía "ollama apagado".
stop_ollama() {
  local m hecho="" mine
  for m in $(ollama ps 2>/dev/null | awk 'NR>1 {print $1}'); do
    [ -n "$m" ] || continue
    if [ -n "$DRY" ]; then echo "  ollama: descargaría $m"; hecho=1; continue; fi
    ollama stop "$m" >/dev/null 2>&1 && { echo "  ollama: modelo $m descargado de la VRAM"; hecho=1; }
  done
  mine="$(pgrep -u "$(id -u)" -f '^([^ ]*/)?ollama serve' 2>/dev/null | head -1)"
  if [ -n "$mine" ]; then
    if [ -n "$DRY" ]; then echo "  ollama: detendría el servidor propio (pid $mine)"
    else kill_tree "$mine"; echo "  ollama: servidor propio detenido (pid $mine)"; fi
    hecho=1
  elif pgrep -x ollama >/dev/null 2>&1; then
    if systemctl is-active --quiet ollama 2>/dev/null; then
      echo "  ollama: el servicio es de systemd y corre como otro usuario, no puedo matarlo."
      echo "          Los modelos ya se descargaron (que es lo que ocupaba la VRAM)."
      echo "          Para bajar el servicio entero:  sudo systemctl stop ollama"
    else
      echo "  ollama: corre bajo otro usuario, no puedo matarlo (modelos ya descargados)"
    fi
  fi
  [ -n "$hecho" ]
}

stop_all() {
  local keep_ollama="" n=0 pid
  for a in "$@"; do
    [ "$a" = "--keep-ollama" ] && keep_ollama=1
    [ "$a" = "--dry-run" ] && DRY=1
  done
  if [ -n "$DRY" ]; then echo "Hannah — SIMULACRO (no se mata nada):"; else echo "Hannah — apagando:"; fi
  # 1) la app de escritorio (por su ruta, para no tocar otras apps Electron del sistema)
  # Anclado a la ruta REAL de esta copia y limitado a procesos propios: el patrón suelto
  # "hannah-desktop/node_modules/electron" llegó a coincidir con un shell que solo mencionaba
  # esa cadena en sus argumentos.
  for pid in $(pgrep -u "$(id -u)" -f "$DESK_RE/node_modules/electron" 2>/dev/null); do
    argv0_in_project "$pid" || continue
    kill_tree "$pid" && { echo "  ventana (pid $pid)"; n=$((n+1)); }
  done
  # 1b) el AppImage del instalador (MODE=appimage): su ejecutable es el propio AppImage (el
  #     runtime) o el binario dentro del montaje FUSE /tmp/.mount_Hannah*/, ninguno dentro del
  #     repo, asi que el paso 1 no lo ve. Se ancla al EJECUTABLE real (/proc/pid/exe), no a la
  #     linea de comandos, para no tocar un editor o un shell que solo mencionen la ruta.
  local ai exe
  ai="$(readlink -f "${HANNAH_APPIMAGE:-$HOME/.local/bin/Hannah.AppImage}" 2>/dev/null)"
  for pid in $(pgrep -u "$(id -u)" -f "Hannah.AppImage|/\.mount_Hannah" 2>/dev/null); do
    exe="$(readlink -f "/proc/$pid/exe" 2>/dev/null)"
    case "$exe" in
      "$ai"|/tmp/.mount_Hannah*/hannah-desktop) ;;
      *) continue ;;
    esac
    kill -0 "$pid" 2>/dev/null || continue     # pudo caer como descendiente del anterior
    kill_tree "$pid" && { echo "  ventana AppImage (pid $pid)"; n=$((n+1)); }
  done
  # 2) servicios, por el puerto en el que escuchan
  for s in $SERVICES; do
    pid="$(port_pid "${s%%:*}")"
    [ -n "$pid" ] || continue
    if ! belongs_to_project "$pid"; then
      echo "  ${s##*:}: hay algo AJENO al proyecto en ${s%%:*} (pid $pid), no lo toco"
      continue
    fi
    kill_tree "$pid" && { echo "  ${s##*:} (pid $pid)"; n=$((n+1)); }
  done
  # 2b) el agente (bun). Su binario está fuera del repo, así que argv0_in_project lo rechaza:
  #     acá manda el cwd (dentro de hannah-agent). Es el ÚNICO caso en que se acepta cwd solo.
  for pid in $(pgrep -u "$(id -u)" -x bun 2>/dev/null); do
    case "$(readlink -f "/proc/$pid/cwd" 2>/dev/null)" in
      "$AGENT"|"$AGENT"/*) kill_tree "$pid" && { echo "  agent (pid $pid)"; n=$((n+1)); } ;;
    esac
  done
  # 3) sidecars huérfanos: ya no escuchan ningún puerto pero siguen reteniendo VRAM
  for pid in $(pgrep -u "$(id -u)" -f "$PROJECT_RE/.*(sidecar|serve\.main|uvicorn)" 2>/dev/null); do
    argv0_in_project "$pid" || continue     # el ejecutable tiene que ser del repo
    kill_tree "$pid" && { echo "  sidecar huérfano (pid $pid)"; n=$((n+1)); }
  done
  # 4) Ollama y sus modelos cargados (es el que más VRAM retiene)
  if [ -z "$keep_ollama" ] && has ollama; then
    stop_ollama && n=$((n+1))
  fi
  [ "$n" = 0 ] && echo "  (no había nada corriendo)"
  # Comprobar el resultado en vez de suponerlo: ya me pasó de cantar victoria con hyprctl
  # y con el propio Ollama. Si algo sigue arriba, hay que decirlo.
  if [ -z "$DRY" ]; then
    sleep 1
    local quedan="" mods
    for s in $SERVICES; do up "${s%%:*}" && quedan="$quedan ${s##*:}"; done
    if [ -n "$quedan" ]; then echo "  ⚠️  siguen arriba:$quedan"; else echo "  servicios: todos abajo ✓"; fi
    # `ollama stop` vuelve ANTES de que llama-server suelte la memoria: hay que esperar a que
    # se descargue de verdad, no mirar al instante (si no, se reporta un falso "sigue cargado").
    if [ -z "$keep_ollama" ]; then
      for _ in $(seq 1 15); do
        mods="$(ollama ps 2>/dev/null | awk 'NR>1' | wc -l)"
        [ "${mods:-0}" -eq 0 ] 2>/dev/null && break
        sleep 1
      done
      [ "${mods:-0}" -gt 0 ] 2>/dev/null && echo "  ⚠️  Ollama todavía tiene $mods modelo(s) en VRAM"
    fi
    has nvidia-smi && echo "  VRAM en uso: $(nvidia-smi --query-gpu=memory.used --format=csv,noheader)"
  fi
}
# Desinstalar: lo que creó el instalador y nada más. Ollama y sus modelos son del usuario
# (los usa fuera de Hannah), uv y node son herramientas compartidas: se quedan.
uninstall_all() {
  local yes="" dry="" a
  for a in "$@"; do [ "$a" = "--yes" ] && yes=1; [ "$a" = "--dry-run" ] && dry=1; done
  local appimage="${HANNAH_APPIMAGE:-$HOME/.local/bin/Hannah.AppImage}" link="$HOME/.local/bin/hannah"
  local app_data="$HOME/.config/hannah-desktop" agent_cfg="$HOME/.config/hannah-agent"
  local link_ours=""
  [ -L "$link" ] && case "$(readlink -f "$link" 2>/dev/null)" in "$ROOT"/*) link_ours=1 ;; esac
  echo "Hannah, desinstalar. Se borra:"
  echo "  $ROOT"
  echo "      (repos, entornos Python, pesos, y data/ con tus ajustes, claves y memoria)"
  [ -e "$appimage" ] && echo "  $appimage"
  [ -n "$link_ours" ] && echo "  $link (enlace)"
  [ -d "$app_data" ] && echo "  $app_data (posición de la ventana)"
  [ -d "$agent_cfg" ] && echo "  $agent_cfg"
  echo "Se queda: Ollama y sus modelos, uv, node."
  [ -n "$dry" ] && { echo "(simulacro: no se borra nada)"; return 0; }
  if [ -z "$yes" ]; then
    printf 'Escribe "si" para borrar todo eso: '
    read -r a </dev/tty || a=""
    [ "$a" = "si" ] || { echo "cancelado, no se tocó nada"; return 1; }
  fi
  stop_all --keep-ollama >/dev/null 2>&1
  [ -n "$link_ours" ] && rm -f "$link"
  rm -f "$appimage"
  rm -rf "$app_data" "$agent_cfg"
  rm -rf "$ROOT"
  echo "Hannah desinstalada. Para volver: curl -fsSL https://vanthlabs.org/install.sh | bash"
}
[ "${1:-}" = "uninstall" ] && { shift; uninstall_all "$@"; exit $?; }

# Las manos, bajo demanda: el instalador ya no trae el agente (43 MB de repo + 870 MB de
# dependencias + bun) porque va apagado por defecto. Aquí se instala cuando se quiere.
set_env() {   # set_env CLAVE VALOR en el .env del backend (crea la linea si no existe)
  if grep -q "^#\?[[:space:]]*$1=" "$BACK/.env" 2>/dev/null; then sed -i "s|^#\?[[:space:]]*$1=.*|$1=$2|" "$BACK/.env"
  else printf '\n%s=%s\n' "$1" "$2" >>"$BACK/.env"; fi
}
hands_cmd() {
  case "${1:-}" in
    on)
      if [ ! -d "$AGENT/.git" ]; then
        AGENT="$ROOT/agent"
        echo "Hannah: bajando el agente a $AGENT"
        git clone -q https://github.com/Vanth-Labs/agent.git "$AGENT" || { echo "hannah: no pude clonar el agente" >&2; return 1; }
      fi
      export BUN_INSTALL="$HOME/.bun"; export PATH="$BUN_INSTALL/bin:$PATH"
      if ! has bun; then
        echo "Hannah: instalando bun en ~/.bun (solo para tu usuario)"
        local t; t="$(mktemp)"
        curl -fsSL --proto '=https' --tlsv1.2 -o "$t" https://bun.sh/install && bash "$t" >/dev/null 2>&1; rm -f "$t"
        has bun || { echo "hannah: bun no se instaló (https://bun.sh)" >&2; return 1; }
      fi
      echo "Hannah: dependencias del agente (bun install, un minuto)"
      ( cd "$AGENT" && bun install >/dev/null 2>&1 ) || { echo "hannah: bun install falló en $AGENT" >&2; return 1; }
      [ -f "$HOME/.config/hannah-agent/hannah-agent.jsonc" ] || ( cd "$AGENT" && scripts/install-profile.sh --openrouter >/dev/null 2>&1 ) || true
      set_env AGENT_ENABLED true
      echo "Manos encendidas (AGENT_ENABLED=true)."
      echo "Falta la clave del proveedor (Anthropic u OpenRouter): ⚙ -> Manos en el overlay, o ANTHROPIC_API_KEY / OPENROUTER_API_KEY en $BACK/.env."
      echo "Para que arranque el agente: hannah stop && hannah"
      ;;
    off)
      set_env AGENT_ENABLED false
      echo "Manos apagadas (AGENT_ENABLED=false). No se borra nada; 'hannah hands on' las vuelve a encender. Aplica al próximo arranque."
      ;;
    *) echo "Uso: hannah hands on|off" >&2; return 2 ;;
  esac
}
[ "${1:-}" = "hands" ] && { shift; hands_cmd "$@"; exit $?; }

# El candado evita dos cosas: pisar un `./hannah` que está levantando servicios, y que el
# apagado se anide (al matar Electron, éste dispara SU propio `hannah stop`, que sin flags
# ignoraría un --keep-ollama del apagado externo).
[ "${1:-}" = "stop" ] && {
  shift
  exec 9>"$ROOT/.hannah.lock"
  # exit 1 a propósito: "me negué" tiene que poder distinguirse de "no había nada corriendo".
  flock -n 9 || { echo "Hannah: hay otro arranque o apagado en curso; no hago nada." >&2; exit 1; }
  stop_all "$@"
  exit 0
}

hannah_addr() {
  has hyprctl && hyprctl clients -j 2>/dev/null | python3 -c \
    "import sys,json;print(next((w['address'] for w in json.load(sys.stdin) if (w.get('title') or '').startswith('Hannah')),''))"
}

# Fallback para escritorios sin hyprctl (GNOME, KDE, XFCE, Cinnamon…): fija la ventana
# encima con las herramientas X11 estándar. Funciona en X11 y también en sesiones Wayland
# (la ventana del navegador/app corre bajo XWayland).
place_window_generic() {
  if has wmctrl; then
    wmctrl -r 'Hannah' -b add,above,sticky,skip_taskbar,skip_pager >/dev/null 2>&1
    wmctrl -r 'Hannah' -t -1 >/dev/null 2>&1     # en todos los escritorios
    echo "[hannah] ventana fijada encima con wmctrl" >>"$LOG"; return 0
  fi
  if has kdotool; then
    local id; id="$(kdotool search --name '^Hannah' 2>/dev/null | tail -1)"
    [ -n "$id" ] && { kdotool windowstate --add above "$id" >/dev/null 2>&1; echo "[hannah] fijada con kdotool" >>"$LOG"; return 0; }
  fi
  echo "[hannah] sin herramienta para fijar la ventana encima (probá: ./hannah doctor)" >>"$LOG"
  return 1
}

# Coloca la ventana flotante a pantalla completa en el monitor destino (Hyprland).
# Monitor = $MONITOR si se fijó, si no el ENFOCADO (autodetección, sin hardcode).
place_window() {
  local addr="$1"; has hyprctl || { place_window_generic; return 0; }
  local geo
  geo="$(hyprctl monitors -j | python3 -c "
import sys,json
ms=json.load(sys.stdin); name='$MONITOR'
m=(next((m for m in ms if m['name']==name), None) if name else None) or next((m for m in ms if m.get('focused')), ms[0])
print(m['x'],m['y'],m['width'],m['height'])")"
  read -r MX MY MW MH <<<"$geo"
  hyprctl dispatch setfloating "address:$addr" >/dev/null
  hyprctl dispatch resizewindowpixel "exact $MW $MH,address:$addr" >/dev/null
  hyprctl dispatch movewindowpixel "exact $MX $MY,address:$addr" >/dev/null
  hyprctl dispatch pin "address:$addr" >/dev/null
}

echo "[hannah] $(date) ROOT=$ROOT modo=$MODE" >>"$LOG"

# Si se pidió la app pero no hay Electron de desarrollo, resolve_mode ya degradó a AppImage o navegador.
case "$MODE" in
  appimage) echo "[hannah] $DESK sin node_modules: uso el AppImage $APPIMAGE$(needs_vite && echo ' (HANNAH_DEV=1: frontend desde Vite)')" >>"$LOG" ;;
  browser) [ "${HANNAH_MODE:-app}" = app ] && echo "[hannah] $DESK sin instalar y sin AppImage, uso el navegador" >>"$LOG" ;;
esac

# Instancia única.
exec 9>"$ROOT/.hannah.lock"; flock -n 9 || { echo "[hannah] ya lanzándose" >>"$LOG"; exit 0; }
trap 'flock -u 9 2>/dev/null' EXIT   # salir por cualquier vía suelta el candado

# Si ya está abierta (Hyprland), re-enfocar y salir.
# En modo app NO se re-coloca: la app es un widget que recuerda dónde la dejaste, y
# place_window la estiraría a pantalla completa (que es lo que quiere el modo navegador).
# OJO con la condición: no alcanza con que la VENTANA exista. Si los servicios están caídos
# (p.ej. tras un `hannah stop` que no alcanzó a cerrar la app), salir acá dejaba a Hannah
# abierta pero muda, y Super+H no volvía a levantar nada. Se comprueban los que de verdad
# hacen falta para que hable: backend, Vite (y que hable HTTP, no HTTPS) y el TTS.
EXIST="$(hannah_addr)"
if [ "$MODE" != services ] && [ -n "$EXIST" ] && healthy 3001 && healthy 8002 && { ! needs_vite || { up 5173 && vite_http_ok; }; } && { ! agent_on || healthy 8006; }; then
  [ "$MODE" = browser ] && place_window "$EXIST"
  has hyprctl && hyprctl dispatch focuswindow "address:$EXIST" >/dev/null
  exit 0
fi

# ── Servicios (idempotente) ──────────────────────────────────────────────
# Nota: el `9>&-` va en el GRUPO ( ... ) 9>&-, no en el comando de adentro. Puesto adentro
# solo cerraba el fd del proceso final: la subshell intermedia seguía sosteniendo el candado
# mientras viviera el servicio. Con el `stop` tomando el mismo candado eso era fatal —dejaba el
# apagado como no-op silencioso—, así que además hay un trap que lo suelta pase lo que pase.
# La deriva entre el catálogo y este bloque no puede esperar al próximo `doctor`: si un servicio
# quedó en la lista de apagado y fuera de acá, este arranque es justo el que no lo levanta.
_drift="$(catalog_check)"
[ -n "$_drift" ] && {
  echo "[hannah] catálogo de servicios INCONSISTENTE: $_drift" >>"$LOG"
  echo "hannah: catálogo de servicios inconsistente: $_drift (./hannah doctor)" >&2
}
has ollama && ! pgrep -x ollama >/dev/null 2>&1 && { nohup ollama serve >>"$LOG" 2>&1 & } 9>&-
up 8002 || ( cd "$BACK" && nohup npm run sidecar:tts >>"$LOG" 2>&1 & ) 9>&-
up 8001 || ( cd "$BACK" && nohup npm run sidecar:asr >>"$LOG" 2>&1 & ) 9>&-
# gestos: CUDA si hay, si no CPU (MOTION_DEVICE=auto); PYTHONPATH por si el venv no tiene el paquete editable
# `exec`: sin el, bash deja un envoltorio vivo (por las asignaciones delante del comando no hace
# el exec implicito) que al morir el hijo en `hannah stop` imprime "Terminated ..." en la terminal.
up 8005 || ( cd "$LAB"  && MOTION_DEVICE="${MOTION_DEVICE:-auto}" PYTHONPATH="$LAB/src" exec nohup .venv/bin/python -m uvicorn serve.main:app --port 8005 >>"$LOG" 2>&1 & ) 9>&-
# Las "manos" (hannah-agent, :8006): SOLO si AGENT_ENABLED=true en el .env del backend. Se
# arranca ANTES que el backend para que su health-check inicial lo encuentre vivo.
if agent_on; then
  if ! has bun; then echo "[hannah] AGENT_ENABLED=true pero falta bun (https://bun.sh) — sin manos" >>"$LOG"
  elif [ ! -d "$AGENT" ]; then echo "[hannah] AGENT_ENABLED=true pero no está $AGENT — sin manos" >>"$LOG"
  else
    # El mismo secreto protege la fachada (HANNAH_AGENT_TOKEN) y la API nativa del motor
    # (HANNAH_AGENT_SERVER_PASSWORD, basic auth); el techo de modo lo fija AGENT_MODE del .env.
    # HANNAH_AGENT_DENY_DIRS: en data/ viven settings.json (las claves de los proveedores en
    # claro) y ui-token, y el agente no puede leerlos ni con bash. La regla que el motor ya trae
    # nombra hannah-backend/data, un NOMBRE de carpeta que solo existe en el layout instalado
    # (site/install.sh); en un checkout de desarrollo la carpeta es backend/ y la regla no
    # dispara. Pasamos la ruta que este launcher ya resolvió, correcta en los dos layouts.
    up 8006 || ( cd "$AGENT" && tok="$(agent_token)" \
      && export HANNAH_AGENT_TOKEN="$tok" HANNAH_AGENT_SERVER_PASSWORD="$tok" \
                HANNAH_AGENT_MAX_MODE="$(envval AGENT_MODE)" "$(agent_key_var)=$(agent_key)" \
                HANNAH_AGENT_DENY_DIRS="$BACK/data" \
      && nohup bun run dev serve --port 8006 >>"$LOG" 2>&1 & ) 9>&-
  fi
fi
# Los "ojos" (hannah-sense, :8007): siempre, salvo SENSE_ENABLED=false (escotilla interna). En
# reposo no muestrea nada, así que no cuesta tenerlo arriba; y va antes que el backend, que lee
# el .env (y el token de acá abajo) al arrancar.
if sense_on; then
  if [ ! -x "$BACK/sidecar/sense/.venv/bin/python" ]; then
    echo "[hannah] falta $BACK/sidecar/sense/.venv — sin ojos hasta re-ejecutar install.sh (SETUP.md §3)" >>"$LOG"
  else
    # El token se resuelve ACÁ y no dentro del subshell de fondo: sense_token puede escribir el
    # .env y el backend lo lee al arrancar tres líneas más abajo. Hacerlo en paralelo es una
    # carrera cuyo lado perdedor es un backend con un token distinto al del sidecar, o sea 401
    # en todas las rutas de vigilancia sin una sola línea de error que lo explique.
    SENSE_TOK="$(sense_token)"
    # Los topes viajan explícitos porque el sidecar lee su PROPIO entorno (sense/config.py) y
    # `npm run` no carga el .env: sin esto el backend diría "dos vigilancias como mucho" —y eso
    # es lo que Hannah dice en voz alta al armar— mientras el sidecar aplica otro número. Vacío
    # es válido: config.py cae a su default y avisa.
    up 8007 || ( cd "$BACK" \
      && export HANNAH_SENSE_TOKEN="$SENSE_TOK" \
                SENSE_MAX_WATCHES="$(envval SENSE_MAX_WATCHES)" \
                SENSE_MIN_PERIOD_MS="$(envval SENSE_MIN_PERIOD_MS)" \
                SENSE_DEBOUNCE_N="$(envval SENSE_DEBOUNCE_N)" \
                SENSE_BLIND_MS="$(envval SENSE_BLIND_MS)" \
      && exec nohup npm run sidecar:sense >>"$LOG" 2>&1 & ) 9>&-
  fi
fi
up 3001 || ( cd "$BACK" && nohup node src/server.js >>"$LOG" 2>&1 & ) 9>&-
if ! needs_vite; then
  : # AppImage con su frontend empaquetado: Vite no hace falta (ni el repo del frontend)
elif [ ! -d "$FRONT" ]; then
  echo "hannah: en modo $MODE hace falta el repo del frontend y no está en $FRONT." >&2
  echo "        git clone https://github.com/Vanth-Labs/frontend.git \"$FRONT\" && (cd \"$FRONT\" && npm install --legacy-peer-deps)" >&2
  echo "        (el AppImage no lo necesita: sin HANNAH_DEV=1 y sin HANNAH_MODE, no pasa por aquí)" >&2
  exit 1
elif up 5173; then
  # Puerto ocupado: puede ser un Vite en HTTPS (npm run dev a mano) -> el overlay no carga.
  # (En modo services da igual: HTTPS es justo lo que quiere otro equipo de la red.)
  [ "$MODE" = services ] || vite_http_ok || {
    echo "[hannah] AVISO: hay algo en :5173 que no responde HTTP (¿vite en https?)." >>"$LOG"
    echo "[hannah] El overlay necesita HANNAH_HTTP=1. Cerralo y volvé a lanzar Super+H." >>"$LOG"
    echo "Hay un Vite en :5173 que NO habla HTTP (probablemente 'npm run dev' en https)." >&2
    echo "Cerralo (pkill -f 'bin/vite') y volvé a apretar Super+H." >&2
    exit 1
  }
elif [ "$MODE" = services ]; then
  # Sin ventana aquí: Vite en HTTPS para que mic y cámara funcionen desde otro equipo de la
  # red (un origen que no es localhost necesita HTTPS para getUserMedia).
  ( cd "$FRONT" && HANNAH_LAN=1 nohup npm run dev >>"$LOG" 2>&1 & ) 9>&-
else
  ( cd "$FRONT" && HANNAH_HTTP=1 nohup npm run dev >>"$LOG" 2>&1 & ) 9>&-
fi

# Sección crítica terminada (servicios ya arrancando): SOLTAR el candado antes de las esperas
# largas. Si no, un arranque lento (o un launcher que quede colgado esperando la ventana)
# bloquea todos los Super+H siguientes con "ya lanzándose".
flock -u 9 2>/dev/null

# HANNAH_MODE=services: levantar todo y NO abrir ventana; para verla desde otro equipo de la
# red en el navegador (el avatar se dibuja con la GPU de ese equipo; el backend sigue solo en
# 127.0.0.1 porque Vite le hace de proxy).
if [ "$MODE" = services ]; then
  for _ in $(seq 1 90); do healthy 3001 && up 5173 && healthy 8002 && break; sleep 1; done
  warn_squatters $AUTO_PORTS
  ip="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
  [ -n "$ip" ] || ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  proto=https; vite_http_ok && proto=http
  # El token de la UI: otro equipo lo necesita (el backend lo exige a todo lo que no es loopback).
  tok="$(envval HANNAH_UI_TOKEN)"; [ -n "$tok" ] || tok="$(cat "$BACK/data/ui-token" 2>/dev/null)"
  echo "Hannah lista, sin ventana. Desde otro equipo de la red (acepta el certificado):"
  echo "  ${proto}://${ip:-<ip-de-esta-maquina>}:5173/?token=${tok:-<data/ui-token>}"
  echo "El token va en la URL solo la primera vez (queda en la pestaña). Parar todo: ./hannah stop"
  exit 0
fi

# Si el frontend no llegó a levantar, abrir la ventana igual solo produce un overlay vacío
# indistinguible de "la app no arranca". Mejor decirlo y salir.
READY=""
if needs_vite; then
  for _ in $(seq 1 60); do curl -sf -o /dev/null "$URL" && { READY=1; break; }; sleep 1; done
  warn_squatters $AUTO_PORTS
  if [ -z "$READY" ]; then
    echo "[hannah] el frontend no respondió en 60s ($URL)" >>"$LOG"
    echo "Hannah: el frontend no levantó. Mirá $LOG (¿falló 'npm run dev' en $FRONT?)." >&2
    exit 1
  fi
else
  # sin Vite lo que tiene que estar es el backend (la app habla con :3001 por URL absoluta)
  for _ in $(seq 1 90); do healthy 3001 && { READY=1; break; }; sleep 1; done
  warn_squatters $AUTO_PORTS
  [ -n "$READY" ] || { echo "Hannah: el backend no levantó. Mirá $LOG" >&2; exit 1; }
fi

# ── Navegador en modo-app ────────────────────────────────────────────────
open_browser() {
  local b
  # 1) Chromium-based -> --app (ventana limpia, cross-platform); permisos/autoplay por flags.
  for b in brave google-chrome-stable google-chrome chromium chromium-browser vivaldi-stable microsoft-edge-stable thorium; do
    if has "$b"; then
      echo "[hannah] browser=$b (chromium)" >>"$LOG"
      setsid "$b" --app="$URL" --class=Hannah \
        --user-data-dir="${PROFILE}-chromium" \
        --use-fake-ui-for-media-stream --autoplay-policy=no-user-gesture-required \
        >/dev/null 2>&1 9>&- & return
    fi
  done
  # 2) Firefox/Gecko -> perfil dedicado (user.js con permisos pre-otorgados).
  for b in zen-browser firefox librewolf floorp waterfox; do
    if has "$b"; then
      echo "[hannah] browser=$b (firefox)" >>"$LOG"
      setsid "$b" --no-remote --profile "$PROFILE" --new-window "$URL" >/dev/null 2>&1 9>&- & return
    fi
  done
  echo "[hannah] NO se encontró navegador" >>"$LOG"
}
if [ "$MODE" = app ]; then
  # La app Electron se coloca sola (esquina del monitor del cursor, encima y en todos los
  # escritorios) y tiene instancia única: si ya estaba abierta, este arranque solo la enfoca.
  # Por eso acá no hay que buscar la ventana ni colocarla.
  echo "[hannah] abriendo la app de escritorio" >>"$LOG"
  # HANNAH_ELECTRON_FLAGS: flags extra para Electron, p.ej. --disable-gpu para verla por ssh -X
  # (sin GPU remota Chromium usa SwiftShader: se ve, el 3D va lento). Ojo: la app tiene candado
  # de instancia única, así que si ya hay una Hannah en el escritorio, `./hannah stop` antes.
  # shellcheck disable=SC2086
  ( cd "$DESK" && HANNAH_DEV=1 HANNAH_STOP_ON_EXIT=1 setsid npm start -- ${HANNAH_ELECTRON_FLAGS:-} >>"$LOG" 2>&1 & ) 9>&-
elif [ "$MODE" = appimage ]; then
  # El AppImage del instalador (sin node_modules en hannah-desktop): frontend empaquetado; se
  # relanza solo con sus flags.
  echo "[hannah] abriendo el AppImage" >>"$LOG"
  # shellcheck disable=SC2086
  # Sin HANNAH_DEV: frontend empaquetado. Con HANNAH_DEV=1 en el entorno, el Vite de arriba.
  # shellcheck disable=SC2086
  ( env ${HANNAH_DEV:+HANNAH_DEV=1} HANNAH_STOP_ON_EXIT=1 setsid "$APPIMAGE" ${HANNAH_ELECTRON_FLAGS:-} >>"$LOG" 2>&1 & ) 9>&-
else
  open_browser
  # ── Colocar la ventana encima ─────────────────────────────────────────────
  if has hyprctl; then
    ADDR=""
    for _ in $(seq 1 40); do ADDR="$(hannah_addr)"; [ -n "$ADDR" ] && break; sleep 1; done
    [ -n "$ADDR" ] && place_window "$ADDR"
  else
    # Otros escritorios: no hay forma de esperar la ventana por dirección, así que damos unos
    # segundos a que abra y fijamos por título. (Antes se giraba 40s en vano y se rendía.)
    sleep 4
    place_window_generic \
      || echo "[hannah] tip: la app de escritorio (hannah-desktop) flota sin depender de esto" >>"$LOG"
  fi
fi
echo "[hannah] listo" >>"$LOG"
